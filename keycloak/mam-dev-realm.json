{
  "realm": "mam-dev",
  "enabled": true,
  "displayName": "MAM Dev",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "fileupload-service",
      "name": "File Upload Service",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:8081",
        "http://localhost:8081/*",
        "http://127.0.0.1:8081",
        "http://127.0.0.1:8081/*"
      ],
      "webOrigins": [
        "http://localhost:8081",
        "http://127.0.0.1:8081"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "use.lightweight.access.token.enabled": "false"
      },
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "email",
        "roles",
        "media:upload:create",
        "media:upload:write",
        "media:upload:read",
        "media:upload:complete"
      ],
      "protocolMappers": [
        {
          "name": "fileupload-service audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "fileupload-service",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "preferred_username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "media:upload:create",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "media:upload:write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "media:upload:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "media:upload:complete",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "users": [
    {
      "username": "developer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Developer",
      "email": "developer@example.local",
      "attributes": {
        "tenant_id": [
          "tenant-local"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "developer",
          "temporary": false
        }
      ]
    }
  ]
}
